# ============================================================
# etec_cms_api — environment variables
# Copy to .env for local dev. On RAILWAY, set these in the
# Dashboard -> your service -> Variables (NOT in a file).
# ============================================================

# --- Production (Railway) ---
# DATABASE_URL: use the Railway Reference, do not paste manually:
#   Key:   DATABASE_URL
#   Value: ${{Postgres.DATABASE_URL}}
# NODE_ENV=production

# --- Local development ---
NODE_ENV=development
PORT=8080

# Local Postgres (used ONLY when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123
DB_DATABASE=cms

# JWT — use a long random string in production:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=1d

# Comma-separated extra allowed origins (the code already allows
# localhost + *.vercel.app + *.up.railway.app)
CORS_ORIGIN=https://cms-frontend-tgji.vercel.app
